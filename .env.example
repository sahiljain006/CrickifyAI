# GEMINI_API_KEY: Required for server-side Gemini AI coaching, video analysis, and planner routes.
# Configure this in AI Studio Settings > Secrets or Vercel Project Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides (defaults to gemini-3.1-flash-lite -> gemini-4-hydrogen fallback)
GEMINI_PRIMARY_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODELS=""

# Optional YouTube Data API v3 key for curated tutorial search proxy (/api/youtube/search)
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted (optional locally; auto-injected in production)
APP_URL="http://localhost:3000"
